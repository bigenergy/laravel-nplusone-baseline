{
    "name": "bigenergy/laravel-nplusone-baseline",
    "description": "Catch N+1 regressions in CI. Collects lazy-loading violations across your whole test suite, compares them against a committed baseline, and fails the build only on new ones.",
    "keywords": [
        "laravel",
        "eloquent",
        "n+1",
        "performance",
        "ci",
        "baseline",
        "static-analysis"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Andrey Uzhegov a.k.a bigenergy",
            "email": "bigenergyyy@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/console": "^11.0|^12.0",
        "illuminate/database": "^11.0|^12.0",
        "illuminate/support": "^11.0|^12.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^9.0|^10.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^10.5|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "BigEnergy\\NPlusOne\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BigEnergy\\NPlusOne\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "analyse": "vendor/bin/phpstan analyse",
        "format": "vendor/bin/pint",
        "lint": "vendor/bin/pint --test"
    },
    "extra": {
        "laravel": {
            "providers": [
                "BigEnergy\\NPlusOne\\NPlusOneServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
